<?xml version="1.0" encoding="UTF-8"?>
<!--
  This POM does NOT compile anything: the overlay jar is produced by build.sh.
  It serves two purposes:
    1. It declares the official lombok jar (and ecj) as dependencies, so build.sh
       can resolve them with `mvn dependency:copy-dependencies` instead of curl.
       lombok.version is the single source of truth for which upstream to overlay.
    2. It publishes the built overlay jar (deploy:deploy-file) to GitHub Packages
       under the forked coordinates, versioned to match the overlaid lombok
       (mvn ... -Drevision=1.18.46).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>be.valuya</groupId>
  <artifactId>lombok</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>lombok (Valuya overlay: @OptionalGetter)</name>
  <description>Official Project Lombok, overlaid with the @OptionalGetter annotation and handlers.</description>
  <url>https://github.com/Valuya/lombok-optionalgetter</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>ymajoros</id>
      <name>Yannick Majoros</name>
      <email>yannick@valuya.be</email>
      <organization>Valuya SRL</organization>
      <organizationUrl>https://www.valuya.be</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Valuya/lombok-optionalgetter.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Valuya/lombok-optionalgetter.git</developerConnection>
    <url>https://github.com/Valuya/lombok-optionalgetter</url>
  </scm>

  <properties>
    <!-- The upstream lombok version to overlay. Single source of truth: build.sh reads it, and
         the published artifact version defaults to it. Bump this to track a new lombok release. -->
    <lombok.version>1.18.46</lombok.version>
    <!-- ecj is only needed to compile the (optional) Eclipse handler. -->
    <ecj.version>3.33.0</ecj.version>
    <revision>${lombok.version}</revision>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>${ecj.version}</version>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/Valuya/lombok-optionalgetter</url>
    </repository>
  </distributionManagement>
</project>
